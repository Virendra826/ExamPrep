# =============================================================================
# ExamPrep Backend Environment Configuration
# =============================================================================

# Server Port (default: 4000)
PORT=4000

# Application Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=postgresql://examprep:examprep_secret@localhost:5432/examprep_dev?schema=public

# JSON Web Token Secret Keys (must be at least 16 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_at_least_16_chars_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_at_least_16_chars_long

# Allowed CORS Origins (comma-separated or single domain)
CORS_ORIGIN=http://localhost:5173

# Storage Driver for Uploaded PDFs & Extracted Diagram Images:
# - 'local': Saves files in backend/uploads directory (recommended for local dev)
# - 'supabase': Saves assets to Supabase Storage bucket (production)
# - 's3': AWS S3-compatible bucket
STORAGE_DRIVER=local

# Supabase Storage Configuration (Required if STORAGE_DRIVER=supabase)
# SUPABASE_URL: Your Supabase project URL (e.g. https://[PROJECT_ID].supabase.co)
SUPABASE_URL=
# SUPABASE_SERVICE_KEY: Supabase service_role secret key for backend storage access
SUPABASE_SERVICE_KEY=
# SUPABASE_DIAGRAM_BUCKET: Public storage bucket for extracted question diagrams (default: examprep-diagrams)
SUPABASE_DIAGRAM_BUCKET=examprep-diagrams
# SUPABASE_RAW_UPLOAD_BUCKET: Private storage bucket for original source PDFs (default: examprep-raw-uploads)
SUPABASE_RAW_UPLOAD_BUCKET=examprep-raw-uploads
# SUPABASE_STORAGE_BUCKET: Legacy fallback bucket name
SUPABASE_STORAGE_BUCKET=examprep-assets

# -----------------------------------------------------------------------------
# Google Gemini Multimodal PDF Extraction Configuration
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key (@google/genai SDK).
# If left UNSET or EMPTY: The pipeline automatically and gracefully falls back
# to the local deterministic PDF extraction parser regardless of EXTRACTION_ENGINE setting.
GEMINI_API_KEY=

# GEMINI_MODEL: Model to use for multimodal layout, chemistry & math understanding.
# Default: 'gemini-2.5-flash' (fast, cost-effective multimodal document model)
GEMINI_MODEL=gemini-2.5-flash

# EXTRACTION_ENGINE: Controls PDF ingestion pipeline strategy:
# - 'hybrid' (Default & Recommended for Production): Uses Gemini multimodal extraction as primary;
#   if Gemini confidence is low or critical errors occur, automatically cross-validates and reconciles
#   against deterministic local parser. Recovers missing questions as LOCAL_ONLY_RECOVERED.
# - 'gemini': Uses Gemini extraction directly without local hybrid cross-check (falls back to local only if Gemini fails).
# - 'local': Bypasses Gemini API entirely; uses deterministic offline PDF parser.
EXTRACTION_ENGINE=hybrid

# HYBRID_RECONCILIATION_THRESHOLD: The ratio of non-HIGH confidence questions (0.0 to 1.0)
# above which hybrid reconciliation triggers local parser cross-validation. Default: 0.3 (30%)
HYBRID_RECONCILIATION_THRESHOLD=0.3

# -----------------------------------------------------------------------------
# Legacy Vision Escalation (Optional - Disabled by Default)
# -----------------------------------------------------------------------------
VISION_PROVIDER=disabled
VISION_API_KEY=
